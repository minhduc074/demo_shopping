{
  "version": 2,
  "builds": [
    { "src": "dist/frontend/browser/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/assets/(.*)", "dest": "/assets/$1" },
    { "src": "^/(.+\\.(js|css|ico|png|svg|json|woff2?|ttf|eot))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
